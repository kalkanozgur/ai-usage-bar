{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl", "CMAKE_RC_COMPILER": "rc" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC x64 Debug",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC x64 Release",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW-w64 (MSYS2 UCRT64) Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_RC_COMPILER": "windres"
      }
    },
    {
      "name": "linux-tests",
      "displayName": "Linux: core unit tests only",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "mingw-release", "configurePreset": "mingw-release" },
    { "name": "linux-tests", "configurePreset": "linux-tests" }
  ],
  "testPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug", "output": { "outputOnFailure": true } },
    { "name": "msvc-release", "configurePreset": "msvc-release", "output": { "outputOnFailure": true } },
    { "name": "mingw-release", "configurePreset": "mingw-release", "output": { "outputOnFailure": true } },
    { "name": "linux-tests", "configurePreset": "linux-tests", "output": { "outputOnFailure": true } }
  ]
}
